[Unit]
Description=YesterSites public member gateway
After=network-online.target
[Service]
DynamicUser=yes
WorkingDirectory=/opt/yestersites-members
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
