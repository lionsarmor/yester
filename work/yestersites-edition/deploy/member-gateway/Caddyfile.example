# Merge on_demand_tls into the existing global options block.
{
	on_demand_tls {
		ask http://127.0.0.1:8137/ask
	}
}
# Catch-all with on-demand TLS lets Caddy request certificates for permitted
# individual names. Exact named sites on this server retain their own blocks.
https:// {
	tls {
		on_demand
	}
	@member host *.yestersites.com
	handle @member {
		reverse_proxy 127.0.0.1:8137
	}
	respond 404
}
