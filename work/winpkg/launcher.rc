#include <winver.h>
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 0,10,2,0
PRODUCTVERSION 0,10,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Retro Page"
            VALUE "FileVersion", "0.10.2"
            VALUE "InternalName", "Retro Page"
            VALUE "OriginalFilename", "Retro Page.exe"
            VALUE "ProductName", "Retro Page"
            VALUE "ProductVersion", "0.10.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
