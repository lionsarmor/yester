{
  "expo": {
    "name": "YESTER",
    "slug": "yester-by-roddy",
    "version": "0.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "world.roddy.yester",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "world.roddy.yester",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive.png",
        "backgroundColor": "#20463f"
      },
      "versionCode": 5
    },
    "plugins": [
      "./plugins/browser-transport.cjs"
    ],
    "experiments": {
      "baseUrl": "/yester"
    }
  }
}
